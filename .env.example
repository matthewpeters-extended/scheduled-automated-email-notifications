# "mock" (default) writes sent mail to a local outbox.jsonl file, no SMTP
# account needed. "live" sends through real SMTP using the settings below.
MAIL_MODE=mock

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com

SESSION_SECRET=dev-secret-change-me
CRON_INTERVAL_SECONDS=30
MAIL_MAX_ATTEMPTS=3
